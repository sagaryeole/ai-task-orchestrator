{
  "_comment": "GitHub Copilot CLI provider — uses the logged-in Copilot account",
  "todo_file": "Todo.md",
  "working_directory": ".",
  "prompt_template": "prompts/task_prompt.txt",
  "delay_seconds": 30,
  "subprocess_timeout": null,
  "stall_timeout_seconds": 600,
  "max_retries_per_provider": 1,
  "require_manual_confirmation": false,
  "auto_commit": true,
  "verify_commands": ["python -m unittest discover -s tests"],
  "providers": [
    {
      "name": "copilot",
      "enabled": true,
      "command": "copilot --allow-all-tools --no-ask-user -s -p {{TASK}}",
      "env": {},
      "rate_limit_patterns": ["rate limit", "429", "quota exceeded", "too many requests"],
      "cooldown_seconds": 300
    }
  ]
}
