{
  "todo_file": "Todo.md",
  "working_directory": ".",
  "prompt_template": "prompts/task_prompt.txt",
  "delay_seconds": 65,
  "subprocess_timeout": null,
  "stall_timeout_seconds": 600,
  "max_retries_per_provider": 1,
  "require_manual_confirmation": false,
  "continue_on_failure": true,
  "auto_commit": true,
  "verify_commands": [
    "python -m unittest discover -s tests"
  ],
  "subprocess_timeout_overrides": {
    "[big]": 900,
    "[slow]": 1800
  },
  "log_max_bytes": 10485760,
  "log_backup_count": 5,
  "providers": [
    {
      "name": "kilo",
      "enabled": false,
      "command": "kilo run --auto",
      "env": {},
      "rate_limit_patterns": [
        "rate limit",
        "429",
        "quota exceeded",
        "too many requests"
      ],
      "cooldown_seconds": 300,
      "stats_command": "kilo stats --json"
    },
    {
      "name": "copilot",
      "enabled": false,
      "command": "copilot --allow-all-tools --no-ask-user -s -p {{TASK}}",
      "env": {},
      "rate_limit_patterns": [
        "rate limit",
        "429",
        "quota exceeded",
        "too many requests"
      ],
      "cooldown_seconds": 300
    },
    {
      "name": "lmstudio",
      "enabled": true,
      "command": "python src/task_orchestrator/lmstudio_provider.py",
      "env": {
        "LM_STUDIO_URL": "http://127.0.0.1:1234/v1",
        "LM_STUDIO_MODEL": "qwen/qwen3.5-9b"
      },
      "rate_limit_patterns": [],
      "cooldown_seconds": 60,
      "priority": 1
    },
    {
      "name": "ollama",
      "enabled": false,
      "command": "python src/task_orchestrator/lmstudio_provider.py",
      "env": {
        "PROVIDER_URL": "http://127.0.0.1:11434/v1",
        "PROVIDER_MODEL": "qwen2.5:0.5b"
      },
      "rate_limit_patterns": [],
      "cooldown_seconds": 60,
      "priority": 1
    }
  ],
  "dashboard_port": 8765
}