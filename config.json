{
  "todo_file": "Todo.md",
  "working_directory": ".",
  "prompt_template": "prompts/task_prompt.txt",
  "delay_seconds": 65,
  "subprocess_timeout": null,
  "stall_timeout_seconds": 600,
  "max_retries_per_provider": 1,
  "require_manual_confirmation": false,
  "continue_on_failure": true,
  "auto_commit": true,
  "verify_commands": ["python3 -m unittest discover -s tests"],
  "subprocess_timeout_overrides": {
    "[big]": 900,
    "[slow]": 1800
  },

  "providers": [
    {
      "name": "kilo",
      "enabled": true,
      "command": "kilo run --auto",
      "env": {},
      "rate_limit_patterns": ["rate limit", "429", "quota exceeded", "too many requests"],
      "cooldown_seconds": 300,
      "stats_command": "kilo stats --json"
    }
  ],
  "dashboard_port": 8765
}
