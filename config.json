{
  "todo_file": "Todo.md",
  "working_directory": ".",
  "prompt_template": "prompts/task_prompt.txt",
  "delay_seconds": 60,
  "subprocess_timeout": 180,
  "stall_timeout_seconds": 600,
  "max_retries_per_provider": 1,
  "require_manual_confirmation": true,
  "continue_on_failure": true,
  "auto_commit": false,
  "verify_commands": [],

  "providers": [
    {
      "name": "openrouter-free",
      "enabled": true,
      "command": "kilo --auto --model deepseek/deepseek-chat-v3-0324:free",
      "env": {
        "OPENROUTER_API_KEY": "REPLACE_ME"
      },
      "rate_limit_patterns": ["rate limit", "429", "quota exceeded", "too many requests"],
      "cooldown_seconds": 3600
    },
    {
      "name": "anthropic-claude",
      "enabled": true,
      "command": "kilo --auto --provider anthropic --model claude-sonnet-5",
      "env": {
        "ANTHROPIC_API_KEY": "REPLACE_ME"
      },
      "rate_limit_patterns": ["rate_limit_error", "429", "overloaded_error"],
      "cooldown_seconds": 1800
    },
    {
      "name": "nvidia-nim",
      "enabled": true,
      "command": "kilo --auto --provider openai-compatible --base-url https://integrate.api.nvidia.com/v1 --model meta/llama-3.1-405b-instruct",
      "env": {
        "NVIDIA_API_KEY": "REPLACE_ME"
      },
      "rate_limit_patterns": ["rate limit", "429", "quota"],
      "cooldown_seconds": 3600
    },
    {
      "name": "lmstudio-local",
      "enabled": true,
      "command": "kilo --auto --provider openai-compatible --base-url http://localhost:1234/v1 --model local-model",
      "env": {},
      "rate_limit_patterns": [],
      "cooldown_seconds": 60,
      "priority": 10
    }
  ]
}
